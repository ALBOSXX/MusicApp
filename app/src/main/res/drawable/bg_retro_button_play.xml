<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">


    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#000000" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="#E6FFEF" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#7CFFA3" android:endColor="#1CB955" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>


    <item>
        <layer-list>

            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#000000" />
                    <corners android:radius="10dp" />
                </shape>
            </item>

            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="#5CFF8F" />
                    <corners android:radius="10dp" />
                </shape>
            </item>

            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <stroke android:width="3dp" android:color="#3333FF77" />
                    <corners android:radius="8dp" />
                </shape>
            </item>

            <item android:top="5dp" android:left="5dp" android:right="5dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#0E3F22" android:endColor="#03120A" />
                    <corners android:radius="6dp" />
                </shape>
            </item>

            <item android:top="6dp" android:left="6dp" android:right="6dp" android:height="12dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#26FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="5dp" android:topRightRadius="5dp" />
                </shape>
            </item>

            <item android:gravity="bottom|center_horizontal" android:height="3dp" android:left="18dp" android:right="18dp" android:bottom="9dp">
                <shape android:shape="rectangle">
                    <solid android:color="#BFFFD4" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>