<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Небо: тёмно-фиолетовый -> пурпурный -> розовый у горизонта -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#0B0120"
                android:centerColor="#2B0A55"
                android:endColor="#7A1B8F" />
        </shape>
    </item>

    <!-- Свечение солнца: розовое -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.3"
                android:gradientRadius="70%p"
                android:centerColor="#99FF2BD6"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Тёплое оранжевое ядро солнца -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.3"
                android:gradientRadius="35%p"
                android:centerColor="#55FF8A3D"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Сетка у горизонта, без отступов -->
    <item
        android:drawable="@drawable/bg_grid_horizon"
        android:gravity="bottom|fill_horizontal"
        android:height="230dp" />

</layer-list>