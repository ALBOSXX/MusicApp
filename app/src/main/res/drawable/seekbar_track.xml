<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#030403" android:endColor="#1B1E24" />
            <stroke android:width="1dp" android:color="#7C8290" />
            <corners android:radius="2dp" />
            <size android:height="8dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#7BFFA0" android:centerColor="#19D951" android:endColor="#0A7A28" />
                <corners android:radius="2dp" />
                <size android:height="8dp" />
            </shape>
        </clip>
    </item>
</layer-list>