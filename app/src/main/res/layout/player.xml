<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player_body"
    android:padding="28dp">


    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_title_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_retro_button"
            android:contentDescription="Назад"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_retro_prev"
            android:tint="@color/icon_tint_btn" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:shadowColor="#33FF77"
            android:shadowRadius="6"
            android:singleLine="true"
            android:text="D-PLAYER 2.81 // ミュージック"
            android:textAlignment="center"
            android:textColor="#7CFFA3"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_retro_button"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_retro_next"
            android:tint="@color/icon_tint_btn"
            android:visibility="invisible" />
    </LinearLayout>


    <FrameLayout
        android:id="@+id/playerPfpFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="12dp"
        android:background="@drawable/bg_cd_frame"
        android:padding="18dp"
        app:layout_constraintBottom_toTopOf="@id/lcdDisplay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <ImageView
            android:id="@+id/playerPfp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Компакт-диск"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_retro_cd" />
    </FrameLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lcdDisplay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_lcd_screen"
        android:padding="14dp"
        app:layout_constraintBottom_toTopOf="@id/timeContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvAudioInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:shadowColor="#33FF77"
            android:shadowRadius="4"
            android:text="STEREO  320 KBPS  44.1 KHZ"
            android:textColor="#2BE866"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSongTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="monospace"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:shadowColor="#5CFF8F"
            android:shadowRadius="8"
            android:singleLine="true"
            android:text="1. Crazy Town - Butterfly (3:36) *** "
            android:textColor="#7CFFA3"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAudioInfo" />

        <TextView
            android:id="@+id/tvArtistName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:text="Crazy Town  [2000]"
            android:textColor="#1FB84F"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSongTitle" />

        <LinearLayout
            android:id="@+id/vizContainer"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvArtistName">

            <View
                android:id="@+id/viz1"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz2"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz3"
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz4"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz5"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz6"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz7"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz8"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz9"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz10"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz11"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz12"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz13"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz14"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz15"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz16"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz17"
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz18"
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz19"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
            <View
                android:id="@+id/viz20"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_viz_bar" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== Время и перемотка ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/timeContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/volContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_lcd_screen"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:shadowColor="#5CFF8F"
            android:shadowRadius="6"
            android:text="01:42"
            android:textColor="#7CFFA3"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <SeekBar
            android:id="@+id/songSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:maxHeight="8dp"
            android:minHeight="8dp"
            android:paddingHorizontal="8dp"
            android:progressDrawable="@drawable/seekbar_track"
            android:splitTrack="false"
            android:thumb="@drawable/seekbar_thumb"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvTotalDuration"
            app:layout_constraintStart_toEndOf="@id/tvCurrentTime"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTotalDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_lcd_screen"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="03:36"
            android:textColor="#1FB84F"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== Громкость ===== -->
    <LinearLayout
        android:id="@+id/volContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:text="VOL"
            android:textColor="#1FB84F"
            android:textSize="11sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/volumeSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxHeight="8dp"
            android:minHeight="8dp"
            android:paddingHorizontal="8dp"
            android:progress="70"
            android:progressDrawable="@drawable/seekbar_track"
            android:splitTrack="false"
            android:thumb="@drawable/seekbar_thumb" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_horizontal|bottom"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_retro_button"
                android:contentDescription="Предыдущий"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_retro_prev"
                android:tint="@color/icon_tint_btn" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:text="PREV"
                android:textColor="#1F8F4B"
                android:textSize="9sp" />
        </LinearLayout>

        <Space android:layout_width="14dp" android:layout_height="0dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_retro_button_play"

                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_retro_play"
                android:tint="@color/icon_tint_play" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:text="PLAY"
                android:textColor="#1F8F4B"
                android:textSize="9sp" />
        </LinearLayout>

        <Space android:layout_width="14dp" android:layout_height="0dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_retro_button"
                android:contentDescription="Следующий"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_retro_next"
                android:tint="@color/icon_tint_btn" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:text="NEXT"
                android:textColor="#1F8F4B"
                android:textSize="9sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>